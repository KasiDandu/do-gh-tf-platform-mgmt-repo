# Copy to terraform.tfvars after running bootstrap/ and fill in its outputs.
common_variables = {
  AWS_ROLE_ARN        = "arn:aws:iam::ACCOUNT_ID:role/github-actions-deployer"
  AWS_REGION          = "eu-west-2"
  GLUE_SCRIPTS_BUCKET = "kasidandu-glue-scripts-ACCOUNT_ID"
  LAMBDA_BUCKET       = "kasidandu-lambda-artifacts-ACCOUNT_ID"
}
